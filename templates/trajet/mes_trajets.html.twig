{% extends 'base.html.twig' %}

{% block title %}Mes trajets publiés — Kafoden{% endblock %}

{% block body %}
    <div class="container py-4">

        <h2 class="mb-4">Mes trajets publiés</h2>

        {% if trajets|length == 0 %}
            <p class="text-muted">Vous n'avez pas encore publié de trajet.</p>
        {% else %}
            <div class="row g-3">
                {% for trajet in trajets %}
                    <div class="col-md-6">
                        <div class="card {{ trajet.statut == 'annule' ? 'border-danger' : '' }}">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <div class="fw-semibold">
                                        {{ trajet.depart }} <i class="bi bi-arrow-right"></i> {{ trajet.arrivee }}
                                    </div>
                                    {% if trajet.statut == 'annule' %}
                                        <span class="badge bg-danger">Annulé</span>
                                    {% else %}
                                        <span class="badge bg-success">Actif</span>
                                    {% endif %}
                                </div>

                                <div class="text-muted small mb-2">
                                    <i class="bi bi-clock"></i> {{ trajet.dateDepart|date('d/m/Y') }} à {{ trajet.heureDepart|date('H:i') }}
                                </div>

                                {% if trajet.statut != 'annule' %}
                                    <span class="badge bg-success-subtle text-success-emphasis mb-2">
                                    {{ trajet.placesDisponibles }} place{{ trajet.placesDisponibles > 1 ? 's' : '' }} restante{{ trajet.placesDisponibles > 1 ? 's' : '' }}
                                </span>
                                {% endif %}

                                {% if trajet.reservations|length > 0 %}
                                    <hr>
                                    <h6 class="small fw-semibold mb-2">Passagers</h6>
                                    <ul class="list-unstyled mb-0">
                                        {% for reservation in trajet.reservations %}
                                            <li class="small">
                                                <i class="bi bi-person"></i>
                                                <a href="{{ path('app_profil', {id: reservation.passager.id}) }}">
                                                    {{ reservation.passager.prenom }} {{ reservation.passager.nom }}
                                                </a>
                                                — {{ reservation.placesReservees }} place{{ reservation.placesReservees > 1 ? 's' : '' }}
                                                {% if reservation.statut == 'annulee' %}
                                                    <span class="badge bg-secondary">Annulée</span>
                                                {% endif %}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <p class="text-muted small mb-0 mt-2">Aucune réservation pour l'instant.</p>
                                {% endif %}

                                {% if trajet.statut != 'annule' %}
                                    <div class="d-flex gap-2 mt-3">
                                        <a href="{{ path('app_trajet_modifier', {id: trajet.id}) }}" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-pencil"></i> Modifier
                                        </a>
                                        <a href="{{ path('app_trajet_annuler', {id: trajet.id}) }}"
                                           class="btn btn-outline-danger btn-sm"
                                           onclick="return confirm('Voulez-vous vraiment annuler ce trajet ? Les passagers seront prévenus.');">
                                            <i class="bi bi-x-circle"></i> Annuler
                                        </a>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
{% endblock %}