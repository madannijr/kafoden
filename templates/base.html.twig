<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Kafoden{% endblock %}</title>
    {% block stylesheets %}
        {{ importmap('app') }}
    {% endblock %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark" style="background-color:#0F6E56;">
    <div class="container">
        <a class="navbar-brand text-white fw-bold d-flex align-items-center gap-2" href="{{ path('app_home') }}">
            <i class="bi bi-house-door-fill"></i> Kafoden
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal" aria-controls="menuPrincipal" aria-expanded="false" aria-label="Ouvrir le menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menuPrincipal">
            <div class="d-flex flex-column flex-lg-row gap-2 align-items-lg-center ms-lg-auto mt-3 mt-lg-0">

                {% if app.user %}
                    <a href="{{ path('app_trajet_nouveau') }}" class="btn btn-light btn-sm text-nowrap">
                        <i class="bi bi-plus-circle"></i> Publier un trajet
                    </a>
                    <a href="{{ path('app_mes_reservations') }}" class="btn btn-outline-light btn-sm text-nowrap">
                        <i class="bi bi-calendar-check"></i> Mes réservations
                    </a>
                    <a href="{{ path('app_mes_trajets') }}" class="btn btn-outline-light btn-sm text-nowrap">
                        <i class="bi bi-signpost"></i> Mes trajets
                    </a>

                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin') }}" class="btn btn-warning btn-sm text-nowrap">
                            <i class="bi bi-shield-lock"></i> Administration
                        </a>
                    {% endif %}

                    <div class="vr text-white opacity-50 mx-1 d-none d-lg-block"></div>

                    <a href="{{ path('app_mon_profil') }}" class="d-flex align-items-center gap-2 bg-white bg-opacity-10 rounded px-2 py-1 text-decoration-none">
                        {% if app.user.photo %}
                            <img src="{{ asset('uploads/photos/' ~ app.user.photo) }}" alt="" class="rounded-circle" style="width:24px;height:24px;object-fit:cover;">
                        {% else %}
                            <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center fw-semibold" style="width:24px;height:24px;font-size:11px;">
                                {{ app.user.prenom|slice(0,1) }}{{ app.user.nom|slice(0,1) }}
                            </div>
                        {% endif %}
                        <span class="text-white small text-nowrap">{{ app.user.prenom }} {{ app.user.nom }}</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm text-nowrap">Se déconnecter</a>

                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-outline-light btn-sm text-nowrap">Se connecter</a>
                    <a href="{{ path('app_register') }}" class="btn btn-light btn-sm text-nowrap">S'inscrire</a>
                {% endif %}

            </div>
        </div>
    </div>
</nav>
<div class="container mt-3">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}
</div>

<main>
    {% block body %}{% endblock %}
</main>

<footer class="text-center text-muted py-4 mt-5 border-top">
    <small>&copy; {{ "now"|date("Y") }} Kafoden — Covoiturage en Guinée</small>
</footer>

{% block javascripts %}{% endblock %}
</body>
</html>