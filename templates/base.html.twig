<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Kafoden{% endblock %}</title>
    {% block stylesheets %}
        {{ importmap('app') }}
    {% endblock %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
<nav class="navbar navbar-expand-lg" style="background-color:#0F6E56;">
    <div class="container">
        <a class="navbar-brand text-white fw-bold" href="{{ path('app_home') }}">Kafoden</a>
        <div class="d-flex gap-2 align-items-center">
            {% if app.user %}
                <span class="text-white small">
            <i class="bi bi-person-circle"></i> {{ app.user.prenom }} {{ app.user.nom }}
        </span>
                <a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm">Se déconnecter</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-outline-light btn-sm">Se connecter</a>
                <a href="{{ path('app_register') }}" class="btn btn-light btn-sm">S'inscrire</a>
            {% endif %}
        </div>
    </div>
</nav>
<div class="container mt-3">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}
</div>

<main>
    {% block body %}{% endblock %}
</main>

<footer class="text-center text-muted py-4 mt-5 border-top">
    <small>&copy; {{ "now"|date("Y") }} Kafoden — Covoiturage en Guinée</small>
</footer>

{% block javascripts %}{% endblock %}
</body>
</html>