{% extends 'base.html.twig' %}

{% block title %}Changer ma photo — Kafoden{% endblock %}

{% block body %}
    <div class="container py-5" style="max-width: 480px;">

        <a href="{{ path('app_mon_profil') }}" class="text-decoration-none text-muted small d-inline-block mb-3">
            <i class="bi bi-arrow-left"></i> Retour à mon profil
        </a>

        <h2 class="mb-4 text-center">Changer ma photo de profil</h2>

        {{ form_start(photoForm, {'attr': {'class': 'card shadow-sm border-0 p-4', 'enctype': 'multipart/form-data'}}) }}

        <div class="mb-4">
            {{ form_label(photoForm.photoFichier, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(photoForm.photoFichier, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(photoForm.photoFichier) }}
        </div>

        <button type="submit" class="btn btn-primary w-100">Enregistrer la photo</button>

        {{ form_end(photoForm) }}

    </div>
{% endblock %}